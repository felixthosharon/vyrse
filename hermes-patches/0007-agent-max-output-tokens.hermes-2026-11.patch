diff --git a/tui_gateway/agent_callbacks.py b/tui_gateway/agent_callbacks.py
index f2c019ed..82d26324 100644
--- a/tui_gateway/agent_callbacks.py
+++ b/tui_gateway/agent_callbacks.py
@@ -346,6 +346,17 @@ def _cfg_max_turns(cfg: dict, default: int) -> int:
     return default if raw is None else _resolve_turn_limit(raw, default=default)
 
 
+def _cfg_max_output_tokens(cfg: dict) -> int | None:
+    """``agent.max_output_tokens``: the most tokens one model reply may generate (None = no cap, the
+    default). A small local model that loops otherwise generates until the server is killed."""
+    raw = (cfg.get("agent") or {}).get("max_output_tokens")
+    try:
+        value = int(raw) if raw is not None else 0
+    except (TypeError, ValueError):
+        return None
+    return value if value > 0 else None
+
+
 def _parse_tui_skills_env() -> list[str]:
     raw = os.environ.get("HERMES_TUI_SKILLS", "")
     return list(dict.fromkeys(p.strip() for p in raw.replace("\n", ",").split(",") if p.strip()))

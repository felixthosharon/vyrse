{
  "manifest_version": 3,
  "name": "VYRSE",
  "version": "1.3.0",
  "description": "Lets VYRSE, running on this PC, read and use your Chrome tabs when you ask it to.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "alarms",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VYRSE",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
